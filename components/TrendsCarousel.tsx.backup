'use client';
import React from 'react';

export function CaseStudiesCarousel() {
  const [caseStudies, setCaseStudies] = React.useState([]);
  const [loading, setLoading] = React.useState(true);

  React.useEffect(() => {
    fetch('/api/case-studies')
      .then(res => res.json())
      .then(data => {
        setCaseStudies(data.items || []);
        setLoading(false);
      })
      .catch(err => {
        console.error(err);
        setLoading(false);
      });
  }, []);

  if (loading || caseStudies.length === 0) {
    return null;
  }

  return (
    <div className="max-w-7xl mx-auto px-4">
      <h2 className="text-5xl font-extrabold mb-10 text-black">Our Work</h2>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {caseStudies.slice(0, 6).map((study) => {
          const title = study.fields?.title || 'Untitled';
          const desc = study.fields?.problemStatement || '';
          const key = study.fields?.key || study.sys?.id;
          
          return (
            <a 
              key={study.sys.id}
              href={`/${key}`}
              rel="noopener noreferrer"
              className="case-study block relative overflow-hidden opacity-100 hover:opacity-80 transition-opacity duration-300"
              style={{ aspectRatio: '1 / 1', transform: 'translateZ(0px)' }}
            >
              <div className="image-filter absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div className="absolute inset-0 flex flex-col justify-end p-8 text-white z-10">
                <h3 className="font-bold text-xl mb-2 leading-tight">{title}</h3>
                <p className="text-sm text-gray-200 line-clamp-2 leading-relaxed">{desc.substring(0, 100)}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  );
}
