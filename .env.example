# PH1 Prompt-Driven Website Environment Variables

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Contentful CMS (if using)
CONTENTFUL_SPACE_ID=your_contentful_space_id
CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token
CONTENTFUL_MANAGEMENT_TOKEN=your_contentful_management_token

# Authentication
JWT_SECRET=your_jwt_secret_for_admin_auth
ADMIN_PASSWORD=your_secure_admin_password

# Vercel/Deployment
VERCEL_URL=your_vercel_app_url

# Development
NODE_ENV=development
